{
	"Verbose": false,
	"Debug": false,
	"IgnoreDefaults": false,
	"SpacesAfterTabs": false,
	"NoColor": false,
	"Exclude": [
		".git",
		".Build",
		"node_modules",
		".DS_Store",
		".xsd",
		".php-cs-fixer.cache",
		"LICENSE",
		"ViteAssetCollector.json",
		"var",
		"vendor"
	],
	"AllowedContentTypes": [],
	"PassedFiles": [],
	"Disable": {
		"EndOfLine": false,
		"Indentation": false,
		"IndentSize": false,
		"InsertFinalNewline": false,
		"TrimTrailingWhitespace": false,
		"MaxLineLength": false
	}
}
