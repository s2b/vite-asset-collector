includes:
	- ../../.Build/vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
	level: 5
	phpVersion: 80200
	treatPhpDocTypesAsCertain: true

	paths:
		- ../../Classes/
		- ../../Configuration/
		- ../../Tests/
		- ../../ext_localconf.php
		- ../../ext_emconf.php

	excludePaths:
		- ../../.Build/
		- ../../Build/
		- ../../var/ (?)

	typo3:
		requestGetAttributeMapping:
			nonce: TYPO3\CMS\Core\Security\ContentSecurityPolicy\ConsumableNonce

	ignoreErrors:
		-
			message: '#^Variable \$_EXTKEY might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: ../../Tests/Fixtures/symlink_extension/ext_emconf.php
		-
			message: '#^Variable \$_EXTKEY might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: ../../Tests/Fixtures/test_extension/ext_emconf.php
		-
			message: '#^Variable \$_EXTKEY might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: ../../ext_emconf.php
